# Copie ce fichier en `.env` et renseigne ton Client ID Spotify.
# https://developer.spotify.com/dashboard -> Create app
#
# Dans les settings de l'app Spotify, ajoute EXACTEMENT cette Redirect URI :
#   http://127.0.0.1:5173/callback
# (Spotify refuse "localhost" depuis 2025, il faut bien 127.0.0.1)
#
# Aucun client secret n'est necessaire : on utilise le flow PKCE.
VITE_SPOTIFY_CLIENT_ID=

# Optionnel : forcer une redirect URI (sinon deduite de window.location.origin)
# VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/callback
